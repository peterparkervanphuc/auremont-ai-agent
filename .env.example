# Copy this file to .env and fill in your values. Never commit .env to git.

# ---- App Configuration ----
APP_NAME=AI20K Project
APP_ENV=development
APP_PORT=8000
APP_HOST=0.0.0.0
LOG_LEVEL=INFO
# Blank = auto (JSON in production, readable text in development). Set true/false to force one format regardless of APP_ENV.
LOG_JSON=
# Logs the first 200 chars of the Sale's question to the audit log (feeds the "Đánh giá AI" tab). Set false if internal policy forbids storing question content.
LOG_QUERY_TEXT=true

# ---- Authentication ----
SECRET_KEY=your-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ---- Database (optional - fill in if using SQL DB) ----
# Example PostgreSQL: postgresql://user:password@localhost:5432/dbname
# Example MySQL: mysql+pymysql://user:password@localhost:3306/dbname
# Example SQLite: sqlite:///./data/app.db
# Production (Aiven Always-Free MySQL): get the full connection string (with SSL param) from Aiven console — Service overview > Connection information > "SQLAlchemy" tab.
DATABASE_URL=

# ---- Gemini LLM ----
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-3.5-flash-lite

# ---- CORS ----
# Production: set to the real Vercel domain (e.g. https://p110.vercel.app) — leaving localhost here blocks CORS entirely.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ---- AI Hook Logging (provided by instructor) ----
AI_LOG_SERVER=https://ai-logs.note.transformerlabs.ai/api/ingest
AI_LOG_API_KEY=your-ai-log-key-here
AI_LOG_DIR=.ai-log

# Public bucket base URL; backend appends <base>/<manifest-path>. R2: enable "Public Development URL" in bucket Settings and paste it here.
PROJECT_IMAGES_BASE_URL=https://pub-2b6dd93e8e8948099737838a9bf56770.r2.dev

# Set false in environments that already have real data, to skip auto-seeding demo data.
AUTO_LOAD_DEMO_DATA=true

# ---- MODEL EMBEDDING  ----
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=768
UPLOAD_MAX_BYTES=20971520
# "high_risk" blocks only contextual attack instructions; "warning" also blocks standalone
# security terms; "disabled" records findings without blocking.
DOCUMENT_SECURITY_BLOCK_THRESHOLD=high_risk
DOCUMENT_SECURITY_MAX_FINDINGS=20
DOCUMENT_SECURITY_EXCERPT_CONTEXT_CHARS=80

# ---- HYBRID SEARCH (BM25 + RRF) ----
# Runs BM25 keyword search alongside vector search, merged via Qdrant's RRF. Vector search captures meaning but blurs identifiers ("2PN" ~ "3PN"); BM25 matches tokens exactly.
# Enable only AFTER re-running POST /documents/{id}/reindex for every document — existing collections have no sparse vectors yet. Safe to disable anytime to fall back to vector-only search, no code changes needed.
HYBRID_SEARCH_ENABLED=true
# BM25 model runs locally via FastEmbed, no external API calls.
SPARSE_MODEL_NAME=Qdrant/bm25
# Maximum time to wait for Qdrant on the interactive retrieval path.
QDRANT_TIMEOUT_SECONDS=5

# ---- RERANKING (Cohere Rerank v3.5) ----
# Cross-encoder that jointly encodes query+passage, far more accurate than the identifier-overlap heuristic it replaces. Uses the hosted API (not self-hosted) since the backend runs on Render's free tier, where loading a few-hundred-MB model at cold start would OOM.
# Disabled by default: a missing API key or a failed API call will NOT break retrieval — rag_service falls back to the old identifier-overlap heuristic automatically.
RERANK_ENABLED=true
COHERE_API_KEY=
COHERE_RERANK_MODEL=rerank-v3.5
# Rerank is optional, so fail fast to the local ranker instead of consuming the whole
# response-time budget. SDK retries are disabled in code for the same reason.
COHERE_RERANK_TIMEOUT_SECONDS=2.5

# ---- CONTEXT SELECTION ----
# Hard prompt budget after reranking. Whole chunks are kept or dropped; legal clauses and
# table rows are never cut halfway. Near-duplicate overlapping chunks from the same file
# are removed before this budget is applied.
RAG_MAX_CONTEXT_CHARS=12000
RAG_DUPLICATE_SIMILARITY_THRESHOLD=0.88

# ---- TRACING (eval flywheel) ----
# Records every step of each question: routing decision, tool calls + latency, retry count, whether a correction happened, Verifier failure_mode. Distinct from the audit log (1 row/request, stored in MySQL): trace answers "which path did the agent take", audit answers "who did what".
# Used to build the eval set: enable, ask a few dozen questions, then run:
#   python scripts/run_eval.py --fail-under 0.9
# Disabled by default: writes to local disk, which is ephemeral on Render, so it's meaningless in prod.
TRACING_ENABLED=true
TRACE_FILE=eval/runs.jsonl

# ---- REFLECTION MEMORY (lessons learned from the agent's own mistakes) ----
# When the Verifier rejects an answer, the system distills the failure into a short lesson (trigger / lesson / fix) and stores it in Redis. A similar question later receives that lesson BEFORE generation, so the agent stops repeating the same mistake across sessions.
# Distinct from memory_service: that one remembers the ASKER, this one remembers the AGENT'S MISTAKES. Lesson count and length are capped — too much memory makes the prompt noisy and burns tokens.
REFLECTION_MEMORY_ENABLED=true
# 30 days: lessons drawn from an old document set become wrong once Admin replaces the document.
REFLECTION_TTL_SECONDS=2592000

# ---- Customer chat (public/anonymous flow, backend/routers/customer_chat.py) ----
# Number of questions an anonymous customer can ask before being required to sign up/log in.
CUSTOMER_ANONYMOUS_TURN_LIMIT=4
# Per-IP rate limit on endpoints that don't require login (anonymous session creation, anonymous questions).
ANONYMOUS_RATE_LIMIT_PER_WINDOW=20
ANONYMOUS_RATE_LIMIT_WINDOW_SECONDS=300
# How many reverse proxies sit in front of the app. Leave 0 when the app is reached directly:
# X-Forwarded-For is then ignored, because any client can set it and forge a new IP per
# request. Behind Render/nginx/a load balancer set the real hop count (usually 1), otherwise
# every visitor arrives as the proxy's address and shares a single rate-limit bucket.
TRUSTED_PROXY_COUNT=0

# ---- LEAD CAPTURE & SCORING ----
# Every customer turn is scored HOT/WARM/COLD so a Sale knows who to call first. Hard signals
# (stated budget, asking to book a viewing, asking for a human, contact details on file) are
# scored by rules in code — they sit on the path of every turn and must keep working when
# Gemini is down. The LLM only reads two soft signals no regex can judge: how urgent the
# person sounds, and whether they are buying to live in or to invest.
LEAD_SCORING_ENABLED=true
LEAD_SCORING_LLM_ENABLED=true
# The LLM's contribution is capped at 30 points, below LEAD_WARM_THRESHOLD, so a lead with no
# hard signal can never be promoted past COLD by the model alone. That cap is what makes this
# hybrid rather than an LLM classifier with extra steps.
LEAD_HOT_THRESHOLD=65
LEAD_WARM_THRESHOLD=35
# Cost brake. The pipeline already spends 2 Gemini calls per turn; a 3rd on every turn would be
# +50%. The LLM pass only runs when the rule score sits BETWEEN the two thresholds — below it
# cannot change the tier (see the cap above), at or above it the lead is already top priority —
# and then only every N turns unless a new hard signal just landed. That keeps it under ~10%.
LEAD_LLM_MIN_TURNS=3
# Only the customer's own messages are ever sent. Including the AI's replies would let one
# hallucinated "anh/chị cần mua gấp phải không ạ?" score itself.
LEAD_LLM_MAX_HISTORY_TURNS=6
# Waiting longer than this outranks any tier in the live inbox. Without it a steady trickle of
# HOT leads starves a COLD customer who is a real person watching a spinner after asking for a
# human.
LEAD_INBOX_FAIRNESS_MINUTES=10
# Set false to accept registrations without a phone number. Watch `contact_rate` on the Admin
# lead stats before and after: requiring it captures more numbers but converts fewer visitors.
LEAD_REQUIRE_PHONE_ON_REGISTER=true

# ---- Inventory API (real-time inventory lookup) ----
# Build phase uses a mock API on mockapi.io, matching the internal API's shape:
# [{ "unit_code": "R1.03-1205", "project_id": "ocean-park-1", "subdivision": "The Zenpark",
#    "tower": "R1.03", "floor": "12", "unit_type": "2PN", "area_m2": 68.2,
#    "direction": "Đông Nam", "view_type": ["Hồ", "Cảnh quan nội khu"],
#    "price": 3600000000, "status": "available" }]
# Switching to the real API in production only requires changing the two variables below, no code changes.
INVENTORY_API_URL=
INVENTORY_API_KEY=
# Bridges two different id schemes: the `projects` table keys by catalogue slug (the-palma, vinhomes-ocean-park...), while the inventory API keys by its own project code (ocp1). Sending the slug straight to the API 404s -> Sale always sees "Tạm thời không tra được tồn kho".
# Syntax: comma-separated `slug=code` pairs. `*=code` is the default entry, used for slugs not listed AND for sessions with no project attached.
# `*=code` alone is NOT enough once a question resolves a SPECIFIC named project: agent_pipeline._tool_call's has_exact_project_mapping guard treats a catch-all-only mapping as "not really this project's data" and skips the lookup, to stop a generic demo blob being relabeled as one named project's real stock. Give every catalogue slug the mock data genuinely covers its own explicit entry.
# Example (this build's mock data): INVENTORY_PROJECT_MAP=hai-au=ocp1,sao-bien=ocp1,ngoc-trai=ocp1,the-pavilion=ocp1,the-sapphire=ocp1,the-zenpark=ocp1,the-zurich=ocp1,*=ocp1
# Empty = pass the slug straight to the API (use when the real API shares the same slug scheme).
INVENTORY_PROJECT_MAP=
