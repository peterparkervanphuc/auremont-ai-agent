# ============================================
# AI20K Project — Environment Variables
# ============================================
# Copy this file to .env and fill in your values
# NEVER commit .env to git!

# ---- App Configuration ----
APP_NAME=AI20K Project
APP_ENV=development
APP_PORT=8000
APP_HOST=0.0.0.0
LOG_LEVEL=INFO

# ---- Authentication ----
SECRET_KEY=your-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ---- Database (optional - fill in if using SQL DB) ----
# Example PostgreSQL: postgresql://user:password@localhost:5432/dbname
# Example MySQL: mysql+pymysql://user:password@localhost:3306/dbname
# Example SQLite: sqlite:///./data/app.db
DATABASE_URL=

# ---- Gemini LLM ----
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.0-flash

# ---- CORS ----
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ---- AI Hook Logging (provided by instructor) ----
AI_LOG_SERVER=https://ai-logs.note.transformerlabs.ai/api/ingest
AI_LOG_API_KEY=your-ai-log-key-here
AI_LOG_DIR=.ai-log

# ---- MODEL EMBEDDING  ----
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=768
UPLOAD_MAX_BYTES=20971520