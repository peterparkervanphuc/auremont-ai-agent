# Copy this file to .env and fill in your values. Never commit .env to git.

# ---- App Configuration ----
APP_NAME=AI20K Project
APP_ENV=development
APP_PORT=8000
APP_HOST=0.0.0.0
LOG_LEVEL=INFO
# Blank = auto (JSON in production, readable text in development). Set true/false to force one format regardless of APP_ENV.
LOG_JSON=
# Logs the first 200 chars of the Sale's question to the audit log (feeds the "Đánh giá AI" tab). Set false if internal policy forbids storing question content.
LOG_QUERY_TEXT=true
# Maximum time spent on each MySQL/Qdrant/Redis readiness check.
HEALTH_CHECK_TIMEOUT_SECONDS=3

# ---- Authentication ----
SECRET_KEY=your-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ---- Database (optional - fill in if using SQL DB) ----
# Example PostgreSQL: postgresql://user:password@localhost:5432/dbname
# Example MySQL: mysql+pymysql://user:password@localhost:3306/dbname
# Example SQLite: sqlite:///./data/app.db
# Production (Aiven Always-Free MySQL): get the full connection string (with SSL param) from Aiven console — Service overview > Connection information > "SQLAlchemy" tab.
DATABASE_URL=

# ---- Gemini LLM ----
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-3.5-flash-lite

# ---- CORS ----
# Production: set to the real Vercel domain (e.g. https://p110.vercel.app) — leaving localhost here blocks CORS entirely.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ---- AI Hook Logging (provided by instructor) ----
AI_LOG_SERVER=https://ai-logs.note.transformerlabs.ai/api/ingest
AI_LOG_API_KEY=your-ai-log-key-here
AI_LOG_DIR=.ai-log

# Public bucket base URL; backend appends <base>/<manifest-path>. R2: enable "Public Development URL" in bucket Settings and paste it here.
PROJECT_IMAGES_BASE_URL=https://pub-2b6dd93e8e8948099737838a9bf56770.r2.dev

# Set false in environments that already have real data, to skip auto-seeding demo data.
AUTO_LOAD_DEMO_DATA=true

# ---- MODEL EMBEDDING  ----
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=768
UPLOAD_MAX_BYTES=20971520
# "high_risk" blocks only contextual attack instructions; "warning" also blocks standalone
# security terms; "disabled" records findings without blocking.
DOCUMENT_SECURITY_BLOCK_THRESHOLD=high_risk
DOCUMENT_SECURITY_MAX_FINDINGS=20
DOCUMENT_SECURITY_EXCERPT_CONTEXT_CHARS=80

# ---- HYBRID SEARCH (BM25 + RRF) ----
# BM25 keyword search alongside vector search, merged via Qdrant's RRF — vector search
# blurs identifiers ("2PN" ~ "3PN"), BM25 matches them exactly. Enable only AFTER
# re-running POST /documents/{id}/reindex for every document (existing collections have
# no sparse vectors yet); safe to disable anytime, falls back to vector-only.
HYBRID_SEARCH_ENABLED=true
SPARSE_MODEL_NAME=Qdrant/bm25
QDRANT_TIMEOUT_SECONDS=5

# ---- RERANKING (Cohere Rerank v3.5) ----
# Cross-encoder reranker; hosted API since Render's free tier can't load the model
# locally. A missing key or failed call falls back to the identifier-overlap heuristic.
RERANK_ENABLED=true
COHERE_API_KEY=
COHERE_RERANK_MODEL=rerank-v3.5
COHERE_RERANK_TIMEOUT_SECONDS=2.5

# ---- CONTEXT SELECTION ----
# Hard prompt budget after reranking. Whole chunks are kept or dropped (never cut halfway);
# near-duplicate overlapping chunks from the same file are removed first.
RAG_MAX_CONTEXT_CHARS=12000
RAG_DUPLICATE_SIMILARITY_THRESHOLD=0.88

# ---- TRACING (eval flywheel) ----
# Records routing/tool-call/retry/Verifier detail per question (distinct from the 1-row
# audit log). Used to build the eval set — enable, ask questions, then run
# `python scripts/run_eval.py --fail-under 0.9`. Disabled by default: writes to local
# disk, which is ephemeral on Render.
TRACING_ENABLED=true
TRACE_FILE=eval/runs.jsonl

# ---- REFLECTION MEMORY (lessons learned from the agent's own mistakes) ----
# On a Verifier rejection, distills the failure into a short lesson stored in Redis; a
# similar question later gets that lesson before generation. Remembers the AGENT's
# mistakes (distinct from memory_service, which remembers the asker).
REFLECTION_MEMORY_ENABLED=true
# 30 days — lessons from an old document set go stale once Admin replaces the document.
REFLECTION_TTL_SECONDS=2592000

# ---- Customer chat (public/anonymous flow, backend/routers/customer_chat.py) ----
# Questions an anonymous customer can ask before being required to sign up/log in.
CUSTOMER_ANONYMOUS_TURN_LIMIT=4
# Per-IP rate limit on endpoints that don't require login.
ANONYMOUS_RATE_LIMIT_PER_WINDOW=20
ANONYMOUS_RATE_LIMIT_WINDOW_SECONDS=300
# Reverse proxies in front of the app. Leave 0 when reached directly (X-Forwarded-For is
# then ignored — any client could forge it). Behind Render/nginx set the real hop count
# (usually 1), otherwise every visitor shares one rate-limit bucket as "the proxy".
TRUSTED_PROXY_COUNT=0

# ---- LEAD CAPTURE & SCORING ----
# Every customer turn is scored HOT/WARM/COLD. Hard signals (budget, booking a viewing,
# asking for a human, contact on file) are rule-scored in code so they keep working when
# Gemini is down; the LLM only reads urgency and buy-to-live-vs-invest, two soft signals
# no regex can judge.
LEAD_SCORING_ENABLED=true
LEAD_SCORING_LLM_ENABLED=true
# LLM contribution is capped at 30 points (below LEAD_WARM_THRESHOLD) so it can never
# promote a lead past COLD alone — this is what makes it hybrid, not an LLM classifier.
LEAD_HOT_THRESHOLD=65
LEAD_WARM_THRESHOLD=35
# Cost brake: the LLM pass only runs when the rule score sits BETWEEN the two thresholds,
# and then only every N turns unless a new hard signal landed — keeps it under ~10% of turns.
LEAD_LLM_MIN_TURNS=3
# Only the customer's own messages are sent — including AI replies would let a
# hallucinated "cần mua gấp phải không ạ?" score itself.
LEAD_LLM_MAX_HISTORY_TURNS=6
# Waiting longer than this outranks any tier in the live inbox, so a steady trickle of
# HOT leads can't starve a COLD customer waiting for a human.
LEAD_INBOX_FAIRNESS_MINUTES=10
# false accepts registrations without a phone — watch `contact_rate` on Admin lead stats
# before/after: requiring it captures more numbers but converts fewer visitors.
LEAD_REQUIRE_PHONE_ON_REGISTER=true

# ---- Inventory API (real-time inventory lookup) ----
# Build phase uses a mock API on mockapi.io, matching the internal API's shape — see
# backend/services/inventory_service.py for the record schema. Switching to the real API
# only requires changing the two variables below, no code changes.
INVENTORY_API_URL=
INVENTORY_API_KEY=
# `projects` keys by catalogue slug (the-palma...); the inventory API keys by its own
# project code (ocp1). Syntax: comma-separated `slug=code` pairs, `*=code` as the default
# for unlisted/no-project sessions. Give every slug the mock data actually covers its own
# entry — a catch-all-only mapping makes has_exact_project_mapping skip the lookup rather
# than relabel another project's stock as this one's. Empty = pass the slug straight
# through (use when the real API shares the same slug scheme).
INVENTORY_PROJECT_MAP=
