# ============================================
# AI20K Project — Environment Variables
# ============================================
# Copy this file to .env and fill in your values
# NEVER commit .env to git!

# ---- App Configuration ----
APP_NAME=AI20K Project
APP_ENV=development
APP_PORT=8000
APP_HOST=0.0.0.0
LOG_LEVEL=INFO
# Định dạng log. Bỏ trống = tự chọn: JSON ở production, text dễ đọc ở development.
# Đặt true/false để ép một kiểu bất kể APP_ENV.
LOG_JSON=
# Ghi 200 ký tự đầu câu hỏi của Sale vào audit log (phục vụ Tab "Đánh giá AI").
# Đặt false nếu chính sách nội bộ không cho lưu nội dung câu hỏi.
LOG_QUERY_TEXT=true

# ---- Authentication ----
SECRET_KEY=your-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ---- Database (optional - fill in if using SQL DB) ----
# Example PostgreSQL: postgresql://user:password@localhost:5432/dbname
# Example MySQL: mysql+pymysql://user:password@localhost:3306/dbname
# Example SQLite: sqlite:///./data/app.db
DATABASE_URL=

# ---- Gemini LLM ----
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-3.5-flash-lite

# ---- CORS ----
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ---- AI Hook Logging (provided by instructor) ----
AI_LOG_SERVER=https://ai-logs.note.transformerlabs.ai/api/ingest
AI_LOG_API_KEY=your-ai-log-key-here
AI_LOG_DIR=.ai-log

# ---- Anh du an (project images) ----
# Anh du an (~58MB) khong nam trong git. Chung song tren mot bucket/CDN cong khai;
# backend tai ve MinIO luc khoi dong theo seed-data/project_images_manifest.json.
# Anh doc an danh qua URL cong khai — KHONG dat AWS key vao day. Doc anh khong
# can credentials, nen khong phai phat tan API key cho ca team.
#
# 1) BASE URL (dang dung) — thu muc cong khai; backend ghep <base>/<duong-dan-manifest>.
#    R2: bat "Public Development URL" trong bucket Settings roi dan URL vao day.
PROJECT_IMAGES_BASE_URL=https://pub-2b6dd93e8e8948099737838a9bf56770.r2.dev
#
# 2) ARCHIVE (thay the) — mot file .tar.gz chua ca 182 anh, tai bang mot request.
#    Tao: cd project-images-source && tar -czf ../project-images.tar.gz .
PROJECT_IMAGES_ARCHIVE_URL=
#
# Bo trong ca hai -> bo qua buoc tai anh, catalogue van chay nhung khong co anh.
# Dat false o moi truong da co du lieu that de khong tu nap du lieu demo.
AUTO_LOAD_DEMO_DATA=true

# ---- MODEL EMBEDDING  ----
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=768
UPLOAD_MAX_BYTES=20971520

# ---- Inventory API (tra cuu ton kho real-time) ----
# Giai doan build dung mock API dung tren mockapi.io, dung shape cua API noi bo:
# [{ "unit_code": "OP3-A-0203", "project_id": "ocean-park-3", "unit_type": "2PN",
#    "price": 3600000000, "status": "available" }]
# Doi sang API that o production chi can sua 2 bien duoi, khong phai sua code.
INVENTORY_API_URL=
INVENTORY_API_KEY=